# MongoDB Connection
DATABASE_URL="mongodb://127.0.0.1:27017/myDB?replicaSet=rs0"

# Server
PORT=8080

# JWT Configuration
JWT_ACCESS_SECRET_KEY="YOUR_ACCESS_SECRET_KEY"
JWT_REFRESH_SECRET_KEY="YOUR_REFRESH_SECRET_KEY"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Contact Form
CONTACT_FORM_EMAIL="YOUR_EMAIL@example.com"

# SMTP Credentials
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="YOUR_EMAIL@example.com"
SMTP_PASS="YOUR_SMTP_PASSWORD"

# Google OAuth
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# URLs
FRONTEND_URL="https://programmingjourneys.com"
BACKEND_URL="https://api.programmingjourneys.com"
